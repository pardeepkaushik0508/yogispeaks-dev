# Backend env for Render (Dashboard → Environment). Do NOT commit real secrets.
# DATABASE_URL / PORT / NODE_ENV are usually provided by Render automatically.

NODE_ENV=production
# PORT is set by Render — do not hardcode unless required

# Link your Render Postgres (Internal Database URL preferred)
DATABASE_URL=

# Generate two long random strings (≥ 32 chars each)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Your public frontend origin(s). MUST include the deployed Render frontend URL
# (e.g. https://yogispeaks-l3vy.onrender.com) or admin login will fail with CORS.
FRONTEND_URL=https://yogispeaks-l3vy.onrender.com
CORS_ORIGINS=https://yogispeaks-l3vy.onrender.com,http://localhost:3000

# true when the site is served over HTTPS
COOKIE_SECURE=true

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# local disk works on a single Render instance; prefer cloudinary/s3 for durable media
MEDIA_PROVIDER=local

REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yogispeaks.local
SMTP_FROM_NAME=YogiSpeaks
