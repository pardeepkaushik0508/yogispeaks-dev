# YogiSpeaks — root environment template
# Copy to `.env` and fill real values locally. NEVER commit `.env`.

# ── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=yogispeaks
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=yogispeaks
DATABASE_URL=postgresql://yogispeaks:changeme_postgres_password@localhost:5432/yogispeaks?schema=public

# ── Redis (optional locally) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Backend ─────────────────────────────────────────────────────────────────
PORT=4000
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
SUPER_ADMIN_EMAIL=admin@yogispeaks.local
SUPER_ADMIN_PASSWORD=ChangeMe_SuperAdmin_1!

# SMTP (console transport used when host empty in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yogispeaks.local
SMTP_FROM_NAME=YogiSpeaks

# Media: local | cloudinary | s3
MEDIA_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Frontend (also copy into frontend/.env.local) ───────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local backend: http://localhost:4000/api/v1
# Deployed backend: https://yogispeaks-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://yogispeaks-backend.onrender.com/api/v1
NEXT_PUBLIC_TINYMCE_API_KEY=
